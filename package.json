{
  "name": "uniqlaw",
  "version": "0.1.0",
  "description": "Multi-channel agent daemon: Telegram / Discord / Slack / LINE chats driven by Claude Code, Codex, OpenCode, Antigravity, ACP agents or any LLM API, with a shared message bus and A2A",
  "license": "MIT",
  "author": "Hans <me@hans00.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hans00/uniqlaw.git"
  },
  "homepage": "https://github.com/hans00/uniqlaw#readme",
  "bugs": "https://github.com/hans00/uniqlaw/issues",
  "keywords": [
    "agent",
    "daemon",
    "claude-code",
    "codex",
    "opencode",
    "telegram",
    "discord",
    "slack",
    "line",
    "mcp",
    "a2a"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "bun-types": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "uniqlaw": "bun packages/cli/src/main.ts",
    "test": "bun test --cwd packages",
    "typecheck": "for p in packages/*/; do bunx tsc -p $p --noEmit || exit 1; done"
  },
  "bin": {
    "uniqlaw": "packages/cli/src/main.ts"
  },
  "overrides": {
    "undici": "^8.12.4",
    "glob": "^14.0.4",
    "minimatch": "^11.0.1"
  }
}
